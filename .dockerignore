# Docker ignore file for BeautiLyze

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/
.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Datasets (large, not needed in container)
datasets/
datasets_hidden/

# Logs
*.log
logs/

# Test outputs
.pytest_cache/
.coverage
htmlcov/
.tox/

# Node modules (not needed for Python service)
node_modules/

# Build artifacts
*.whl
*.tar.gz

# Local development files
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
tmp/
temp/