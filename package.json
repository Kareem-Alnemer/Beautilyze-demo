{
  "name": "beautilyze-tools",
  "private": true,
  "description": "Repository commands and catalog tooling; the mobile app lives in app/.",
  "scripts": {
    "app:start": "npm --prefix app start",
    "app:dev": "npm --prefix app start -- --dev-client",
