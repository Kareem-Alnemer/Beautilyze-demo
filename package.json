    "app:lint": "npm --prefix app run lint",
    "catalog:validate": "node scripts/validate-catalog.mjs"
  },
  "dependencies": {
    "csv-parse": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  }
}
