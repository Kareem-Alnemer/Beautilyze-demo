# BeautiLyze — environment template
# Copy this to .env and fill in real values.
# NEVER commit .env.

# === Supabase ===
# Find these in your Supabase project settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service-role key is used ONLY by local seed scripts.
# NEVER put this in the app. NEVER commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Inference server ===
INFERENCE_SERVER_URL=http://127.0.0.1:8000

# === HuggingFace (for the inference server) ===
# Optional. Only needed if the model requires auth.
HUGGINGFACE_TOKEN=

# === App (Expo uses EXPO_PUBLIC_ prefix for client-visible vars) ===
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_INFERENCE_SERVER_URL=http://127.0.0.1:8000