# Inference Server Configuration
# Copy to .env and adjust as needed

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Model Configuration
MODEL_MODE=mock  # mock | pytorch | onnx
SKIN_TYPE_MODEL_PATH=  # Path to skin type model (PyTorch .pt or ONNX .onnx)
ACNE_SEVERITY_MODEL_PATH=  # Path to acne severity model (PyTorch .pt or ONNX .onnx)
MODEL_VERSION=mock-v1  # Model version string returned in predictions

# Image Processing
MAX_FILE_SIZE_MB=5
ALLOWED_CONTENT_TYPES=image/jpeg,image/png
IMAGE_INPUT_SIZE=224

# CORS (for local development with Expo)
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,exp://127.0.0.1:8081
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Logging
LOG_LEVEL=INFO

# Supabase (for scan history storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key